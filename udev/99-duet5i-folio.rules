# 99-duet5i-folio.rules — แก้ทัชแพต/คีย์บอร์ด folio หลุดเป็นพักๆ บน IdeaPad Duet 5i
#
# สาเหตุ: เคอร์เนลพักอุปกรณ์ USB (autosuspend) หลังไม่ได้ใช้งาน ~2 วินาที
# ทัชแพตของ folio ตื่นจากโหมดนี้ไม่ทัน/ไม่ตื่นบางครั้ง ทำให้ "หลุด" จนต้องรีบูต
# วิธีแก้: สั่งให้อุปกรณ์นี้ไม่เข้าโหมดพัก (power/control = on)
#
# === ขั้นตอนกรอกค่าจริง (ทำครั้งเดียว) ===
# 1) ต่อคีย์บอร์ด folio กับเครื่อง
# 2) รัน:  lsusb
# 3) หาบรรทัดของคีย์บอร์ด/ทัชแพต Lenovo (มักมีคำว่า "Keyboard" หรือ " Lenovo")
# 4) จดค่า VID:PID ตรงท้ายบรรทัด รูปแบบ 1234:5678
# 5) แทนค่า XXXX:XXXX สองบรรทัดด้านล่างด้วยค่าจริง
# 6) รัน:  sudo udevadm control --reload && sudo udevadm trigger
#

# ปิด autosuspend เฉพาะอุปกรณ์ที่ระบุ (เจาะจงที่สุด — วิธีที่แนะนำ)
# SUBSYSTEM=="usb", ATTR{idVendor}=="XXXX", ATTR{idProduct}=="XXXX", TEST=="power/control", ATTR{power/control}="on"
# SUBSYSTEM=="usb", ATTR{idVendor}=="XXXX", ATTR{idProduct}=="XXXX", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1"

# ทางเลือก (ใช้เมื่อยังหา VID:PID ไม่เจอ): ปิด autosuspendกับ "อุปกรณ์ USB ภายในเครื่องทั้งหมด"
# อุปกรณ์ภายใน (รวมขั้ว pogo ของ folio) จะถูกระบุว่า removable=="unknown"
# ผลข้างเคียง: ใช้พลังงานมากขึ้นเล็กน้อย แลกกับความเสถียร
SUBSYSTEM=="usb", ATTR{removable}=="unknown", TEST=="power/control", ATTR{power/control}="on"
